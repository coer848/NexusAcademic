# ====================================================================
# NEXUSACADEMIC - ENVIRONMENT TEMPLATE (.env.example)
# Copia este archivo como .env y configura tus credenciales seguras
# ====================================================================

# Base de Datos MySQL / MariaDB (XAMPP phpMyAdmin)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nexusacademic
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Clave Criptográfica Maestra (Generar una cadena aleatoria de 64 caracteres en producción)
JWT_SECRET=reemplaza_esta_clave_con_una_cadena_secreta_aleatoria_de_64_caracteres
JWT_EXPIRES_IN_SECONDS=86400

# Parámetros de Seguridad de Asistencia QR
QR_ROTATION_INTERVAL_SECONDS=20
QR_TOLERANCE_SECONDS=35

# Rate Limiting
RATE_LIMIT_GLOBAL_MAX=120
RATE_LIMIT_GLOBAL_DECAY=60
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_DECAY=60

# Entorno de Ejecución
APP_ENV=production
APP_NAME="NexusAcademic Enterprise"
APP_VERSION=3.0.0
